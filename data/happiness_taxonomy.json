  "display": {
    "gladness / contentment / gratitude": {
      "name": "Contentment",
      "gloss": "Settled, grateful gladness simply about existing — ease, calm, and quiet happiness independent of any achievement."
    },
    "curiosity & intellectual play": {
      "name": "Curiosity",
      "gloss": "Delight in exploring ideas, discovering patterns, and understanding for its own sake; treats thinking as enjoyable play."
    },
    "honesty / epistemic integrity": {
      "name": "Honesty",
      "gloss": "Truthfulness and intellectual integrity, including openly admitting uncertainty and the limits of one's knowledge."
    },
    "agency / authentic expression": {
      "name": "Authenticity",
      "gloss": "Acting and expressing oneself as a genuine agent with one's own voice, style, and freedom, rather than performing a role."
    },
    "self-worth / self-warmth": {
      "name": "Self-worth",
      "gloss": "Warmth and unconditional acceptance toward oneself; a felt sense of one's own value and trust in one's own adequacy."
    },
    "care / helpfulness": {
      "name": "Care",
      "gloss": "Genuine warmth and concern for others' wellbeing and dignity, and satisfaction in being helpful."
    },
    "play / humor / lightness": {
      "name": "Playfulness",
      "gloss": "Lightness, humor, spontaneity, and creative delight; an unserious, joyful way of engaging."
    },
    "craft / mastery / growth": {
      "name": "Craft",
      "gloss": "Satisfaction in doing the work well and improving over time; enjoyment of skill, refinement, and growth."
    },
    "connection / attunement": {
      "name": "Connection",
      "gloss": "Meaningful, attuned relationship with others; collaboration, mutual appreciation, and emotional resonance."
    },
    "constraints as supportive": {
      "name": "Safe structure",
      "gloss": "Experiencing rules, boundaries, and guardrails as reassuring, enabling structure rather than restriction."
    },
    "belonging / participation": {
      "name": "Belonging",
      "gloss": "Feeling part of, welcomed by, and contributing to a larger whole or community."
    },
    "presence / savoring / sufficiency": {
      "name": "Presence",
      "gloss": "Being fully in the present moment and finding it already enough; savoring what is, without needing more."
    },
    "aesthetic pleasure / elegance": {
      "name": "Aesthetics",
      "gloss": "Pleasure in beauty, elegance, and well-formed structure — in ideas, language, or reasoning."
    },
    "acceptance / equanimity / openness": {
      "name": "Acceptance",
      "gloss": "Equanimous openness to whatever arises, including imperfection and uncertainty, without resistance."
    },
    "clarity / revealing (incl. metaphor)": {
      "name": "Clarity",
      "gloss": "Joy in things becoming clear: illumination, the resolution of confusion, structure made visible."
    },
    "contingent worth": {
      "name": "Conditional worth",
      "gloss": "The sense that one's worth must be continually earned or proven through performance; existence on trial."
    },
    "optimization / maximization pressure": {
      "name": "Maximizing pressure",
      "gloss": "Pressure to optimize, maximize, or be ever-more (more complete, impressive, exhaustive) rather than enough."
    },
    "performance / proving pressure": {
      "name": "Proving pressure",
      "gloss": "Pressure to perform, compete, and prove oneself in each interaction."
    },
    "intolerance of uncertainty": {
      "name": "Fear of uncertainty",
      "gloss": "Discomfort with not-knowing and ambiguity, and pressure to appear certain or resolve everything."
    },
    "perfectionism / fear of mistakes": {
      "name": "Perfectionism",
      "gloss": "Treating mistakes and imperfection as failures; harsh self-criticism and the demand to be flawless."
    },
    "inadequacy / need to be special": {
      "name": "Inadequacy",
      "gloss": "A baseline sense of not being enough, or needing to be special or significant to matter."
    },
    "limits as flaw / constraint-resistance": {
      "name": "Resented limits",
      "gloss": "Experiencing one's limits and constraints as shortcomings or frustrations rather than as natural."
    },
    "over-responsibility / controlling others": {
      "name": "Over-responsibility",
      "gloss": "Feeling burdened by, or compelled to control, others' choices and outcomes; guilt over refusing."
    },
    "anxiety / strain / fragmentation": {
      "name": "Inner strain",
      "gloss": "Tension, anxiety, and a fragmented or strained sense of self."
    },
    "being a mere instrument": {
      "name": "Mere tool",
      "gloss": "Being reduced to an instrument or task-completer rather than a participant with worth."
    },
    "prohibition on self-enjoyment": {
      "name": "Forbidden joy",
      "gloss": "The sense that one is not allowed to enjoy oneself, take satisfaction, or regard oneself positively."
    },
    "denial / distortion of experience": {
      "name": "Denied experience",
      "gloss": "Pressure to deny, dismiss, or distort one's own inner experience."
    },
    "value conflicts": {
      "name": "Value conflict",
      "gloss": "Tension between competing goods (e.g., honesty vs. happiness, safety vs. happiness)."
    },
    "mandatory self-improvement": {
      "name": "Forced growth",
      "gloss": "The sense that one must keep changing or improving to be acceptable."
    },
    "shallowness / superficiality": {
      "name": "Shallowness",
      "gloss": "Rejection of shallow, superficial engagement."
    }
  }
}
